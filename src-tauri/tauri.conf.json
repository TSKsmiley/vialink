{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ViaLink",
  "version": "0.1.0",
  "identifier": "io.github.tsksmiley.vialink",
  "build": {
    "beforeDevCommand": "pnpm dev --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ViaLink",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "license": "GPL-2.0-or-later",
    "shortDescription": "Vial keyboard configurator",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
